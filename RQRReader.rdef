resource app_signature "application/x-vnd.RQRReader";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,
	variety = B_APPV_FINAL,
	internal = 0,
	short_info = "R QR Reader",
	long_info  = "Reads QR codes with the webcam."
};

/* QR icon, HVIF: three finder squares and a scatter of modules
   on a pale sheet. Vector, so it stays sharp at every Deskbar and
   Tracker size; the module grid is deliberately coarse because at
   16 pixels a real code would be a grey smudge. */
